# AI_PROFILE đổi toàn bộ hành vi worker (model/device/compute_type) mà không sửa code.
# Giá trị: local | production-gpu | production-cpu-fallback
AI_PROFILE=local

TRANSCRIPTION_PROVIDER=local_faster_whisper

WHISPER_MODEL=medium
WHISPER_COMPUTE_TYPE=int8
# WHISPER_MODEL_PATH=/models/faster-whisper-medium   # preload local, không tải runtime
WHISPER_LOCAL_FILES_ONLY=false

DIARIZATION_ENABLED=false
OVERLAP_DETECTION_ENABLED=false
SEPARATION_ENABLED=false

# M2 — pyannote diarization. PYANNOTE_MODEL_PATH phải trỏ tới thư mục đã
# preload model qua T-HF-001 (accept license HuggingFace trên máy có internet,
# KHÔNG tải tại runtime container). Chỉ cần set khi DIARIZATION_ENABLED=true.
# PYANNOTE_MODEL_PATH=/models/pyannote
PYANNOTE_LOCAL_FILES_ONLY=true
# PYANNOTE_MODEL_VERSION=pyannote/speaker-diarization-3.1   # chỉ để log/audit, không dùng để tải model
# QUAN TRỌNG (xác nhận thật khi verify T-HF-001/T016, 2026-06-30): pyannote.audio
# dùng cache_dir RIÊNG cho model nested (embedding/segmentation khai báo trong
# config.yaml) — mặc định "~/.cache/torch/pyannote", KHÁC cache chuẩn của
# huggingface_hub ("~/.cache/huggingface/hub" hoặc $HF_HOME). Set biến này trỏ
# đúng nơi đã preload model nested ở bước T-HF-001, nếu không pyannote coi như
# "chưa preload" dù model đã tải về máy.
# PYANNOTE_CACHE=/models/.huggingface-cache

# Threshold gán speaker (plan.md mục 5.3) — business logic, không đổi giữa các profile.
SPEAKER_ASSIGN_MIN_OVERLAP_RATIO=0.65
SPEAKER_ASSIGN_MIN_CONFIDENCE=0.70

MAX_AUDIO_DURATION_LOCAL_SECONDS=300
# T-BENCH-001 (2026-07-01): số đo thật, không phải giá trị đoán — xem quickstart.md.
AI_WORKER_MIN_FREE_RAM_MB=4096
AI_WORKER_TEMP_DIR=
AI_WORKER_TEMP_TTL_MS=86400000
AI_WORKER_PYTHON_BIN=python
AI_WORKER_FFPROBE_BIN=ffprobe
AI_WORKER_FFMPEG_BIN=ffmpeg

# production-gpu only — set true bởi container/runtime khi thật sự có CUDA.
CUDA_AVAILABLE=false

# MinIO/S3 — phải khớp với backend (.env STORAGE_S3_*)
STORAGE_S3_ENDPOINT=localhost
STORAGE_S3_PORT=9000
STORAGE_S3_USE_SSL=false
STORAGE_S3_ACCESS_KEY=minioadmin
STORAGE_S3_SECRET_KEY=minioadmin
STORAGE_S3_BUCKET=capstone-media
